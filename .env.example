# Environment Variables for E-Commerce Data Warehouse

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw

# Full Connection URL (Leave empty to use automatic SQLite fallback)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_dw

# Airflow Configuration
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
